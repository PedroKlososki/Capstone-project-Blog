<%- include('partials/header.ejs') %>

    <% if (locals.editMode) { %>
        <div class="container-fluid align-middle my-5 row justify-content-center h-75">
            <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center rounded-3 border shadow-lg col-lg-5">
                <div class="col-lg-12 p-3 p-lg-5 pt-lg-3 text-center">
                    <h2 class="">Last content</h2>
                    <form class="form d-flex flex-column">
                        <input type="text" class="name" name="name" placeholder="<%= data[Number(editMode["index"])]["name"] %>" disabled/>
                        <textarea class="feedback-input" placeholder="<%= data[Number(editMode["index"])]["text"] %>" disabled></textarea>
                        <input type="submit" class="btn btn-info" value="disabled" disabled/>
                    </form>
                </div>
            </div>
            <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center rounded-3 border shadow-lg col-lg-5">
                <div class="col-lg-12 p-3 p-lg-5 pt-lg-3 text-center">
                    <h2 class="">New Content</h2>
                    <form class="form d-flex flex-column" action="/create/edit/submit" method="POST">
                        <input type="text" class="name" name="name" placeholder="Name" />
                        <input type="hidden" name="id" value="<%= data[Number(editMode["index"])]["id"] %>" />
                        <textarea name="text" class="feedback-input" placeholder="Comment"></textarea>
                        <input type="submit" class="btn btn-info" value="Edit" />
                    </form>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="container-fluid align-middle my-5 row justify-content-center h-75">
            <div class="row p-4 pb-0 pe-lg-0 pt-lg-5 align-items-center rounded-3 border shadow-lg col-lg-6">
                <div class="col-lg-12 p-3 p-lg-5 pt-lg-3 text-center">
                    <form class="form d-flex flex-column" action="/create/submit" method="POST">
                        <input type="text" class="name" name="name" placeholder="Name" />
                        <textarea name="text" class="feedback-input" placeholder="Comment"></textarea>
                        <input type="submit" class="btn btn-info" value="Post" />
                    </form>
                </div>
            </div>
        </div>
    <% } %>
<%- include('partials/footer.ejs') %>